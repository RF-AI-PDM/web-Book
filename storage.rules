rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function isAdmin() {
      return request.auth != null && (request.auth.token.get('admin', false) == true
        || firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)));
    }
    function validImage() {
      return request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }
    match /users/{uid}/customBooks/{bookId}/assets/{assetId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validImage();
      allow delete: if isOwner(uid);
    }
    match /catalog/{bookId}/assets/{assetId} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }
  }
}
